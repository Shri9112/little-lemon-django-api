# Copy this file to .env and fill in your local MySQL details.
# Set DB_ENGINE=sqlite to run without installing MySQL (development smoke test only).
DB_ENGINE=mysql
DB_NAME=littlelemon
DB_USER=littlelemon_user
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
